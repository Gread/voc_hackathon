# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets / local config
.env
.env.*
!.env.example

# Data (raw downloads and large intermediates are re-creatable)
data/raw/
data/cache/
*.db-journal
*.db-wal
*.db-shm

# OS / editors
.DS_Store
Thumbs.db
.vscode/
.idea/

# Node (if a build step is ever added)
node_modules/

# Work bundles for build-time agents are regenerable
data/work/

# Derived index: rebuilt from the files by `voc build-db` in seconds
data/voc.sqlite
data/voc.sqlite-wal
data/voc.sqlite-shm

# Stray working files from build-time agents
scratch/
scratch*
**/_tmp_*
**/tmp_*
**/build_[0-9]*.py
**/write_[0-9]*.py
**/gen_[0-9]*.py
