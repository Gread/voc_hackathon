# Copy to .env and fill in. Never commit .env.
ANTHROPIC_API_KEY=            # live extraction/theming and the live Q&A agent
OPENROUTER_API_KEY=           # alternative provider for the live Q&A agent
VOC_LLM_PROVIDER=anthropic    # anthropic | openrouter
VOC_OR_ASK_MODEL=google/gemini-3.1-pro-preview
VOC_OR_EXTRACT_MODEL=google/gemini-2.5-flash
KAGGLE_API_TOKEN=             # only to re-download raw data from Kaggle mirrors
VOC_LLM=cached                # live | cached | fake
VOC_EXTRACT_MODEL=claude-sonnet-5
VOC_EXTRACT_EFFORT=medium
VOC_THEME_MODEL=claude-sonnet-5
VOC_THEME_EFFORT=medium
VOC_ASK_MODEL=claude-opus-5
VOC_ASK_EFFORT=medium
VOC_ENABLE_FALLBACKS=1
VOC_CONCURRENCY=8
VOC_MAX_USD=100
VOC_DATA_DIR=data
VOC_PORT=8000
VOC_SEED=20260911
VOC_MONTHS=24
VOC_TARGET_CALLS=4000
VOC_COMPANY=JPMORGAN CHASE & CO.
